{
  "name": "pi-readable-edits",
  "version": "0.2.0",
  "description": "Diff cards for files Pi agents change through bash: sed -i, heredocs, scripts, formatters, anything.",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "diff",
    "bash"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shidenkai0/pi-readable-edits.git"
  },
  "homepage": "https://github.com/shidenkai0/pi-readable-edits#readme",
  "bugs": "https://github.com/shidenkai0/pi-readable-edits/issues",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "preview": "tsx scripts/preview.ts",
    "corpus": "tsx scripts/corpus.ts",
    "sample": "tsx scripts/sample.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "0.3.1",
    "diff": "^8.0.4",
    "fast-glob": "^3.3.3",
    "web-tree-sitter": "^0.27.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^26.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
